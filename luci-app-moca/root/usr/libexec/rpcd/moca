#!/bin/sh
# rpcd object "moca": a thin, authenticated HTTP proxy to the
# MaxLinear /ms parameter API on remote MoCA adapters (Frontier FC252,
# Verizon, GoCoax ...).  The browser never talks to the adapters directly and
# never sees their passwords; the router forwards using credentials from
# /etc/config/moca_other.  The target host is resolved from UCI by adapter id,
# so the proxy can only ever reach configured adapters.
#
# Methods:
#   list                        -> { "adapters": [ {id,name,host,vendor,username,enabled} ] }
#   request {id,path,body?}     -> { "code":<http>, "data":<parsed array|null>, "raw":<text> }
#   discover                    -> { "found": [ {ip,mac,chip,name,sw,via} ] }
#   adopt {mac,ip,name?,vendor?,username?,password?,reserve?}
#                               -> { "id":<section>, "reserved":<0|1> }
#
# 'path' is the /ms suffix, e.g. "0/0x1003/GET" or "1/0xb00".
# 'body' defaults to {"data":[]}.

. /usr/share/libubox/jshn.sh

CFG=moca_other
SCAN_OUT=/tmp/moca-scan.json
SCAN_IPS=/tmp/moca-scan.ips
SWEEP_DEFAULT="192.168.144.0/24 192.168.254.254 192.168.188.251 192.168.188.252 192.168.1.3"
DEEP_DEFAULT="192.168 10.0 10.1 172.16"
MPS_OUT=/tmp/moca-mps.json

# MaxLinear / Entropic MoCA OUI hints (discovery is confirmed by an /ms probe,
# not by OUI; these only rank candidates first).
MOCA_OUIS="04:b6:be 00:23:e9 e8:9f:80 5c:35:3b 28:6d:cd b0:e7:de"

cfg_timeout() {
	local t
	config_load "$CFG"
	config_get t globals timeout 6
	[ "$t" -ge 1 ] 2>/dev/null && echo "$t" || echo 6
}

# base64-encode stdin arg (no base64/openssl binary in the image, so use awk).
b64enc() {
	awk -v s="$1" 'BEGIN{
		b="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
		for(i=0;i<256;i++)O[sprintf("%c",i)]=i;
		n=length(s);o="";
		for(i=1;i<=n;i+=3){
			c1=O[substr(s,i,1)];
			c2=(i+1<=n)?O[substr(s,i+1,1)]:0;
			c3=(i+2<=n)?O[substr(s,i+2,1)]:0;
			o=o substr(b,int(c1/4)+1,1) substr(b,(c1%4)*16+int(c2/16)+1,1) \
			    ((i+1<=n)?substr(b,(c2%16)*4+int(c3/64)+1,1):"=") \
			    ((i+2<=n)?substr(b,c3%64+1,1):"=")
		}
		print o
	}'
}

# Pre-emptive HTTP Basic header.  The router's (mbedTLS) curl does not send
# Basic credentials until challenged, and these adapters answer the first
# request with a 401 instead of a proper challenge -- so send it up front.
basic_hdr() {
	printf 'Authorization: Basic %s' "$(b64enc "$1")"
}

# Known factory web credentials per vendor profile ("user:pass").  Used as the
# fallback when an adapter has no explicit password configured, so the user
# only has to override the ones that differ from the manufacturer default.
vendor_default_cred() {
	case "$1" in
		frontier) echo "admin:cambridge" ;;
		gocoax)   echo "admin:gocoaxx" ;;
		verizon)  echo "admin:admin" ;;
		*)        echo "admin:" ;;
	esac
}

# Build the credential list to try while probing: every distinct user:pass
# already configured in the inventory, then the per-vendor factory defaults.
discover_creds() {
	. /lib/functions.sh
	config_load "$CFG"
	add_cred() {
		local s="$1" u p
		config_get u "$s" username "admin"
		config_get p "$s" password ""
		[ -n "$p" ] && echo "$u:$p"
	}
	config_foreach add_cred adapter
	# Factory defaults: frontier, verizon, gocoax (new+old), generic.
	printf '%s\n' admin:cambridge admin:admin admin:gocoax admin:gocoaxx admin:goCoax@2018 \
		admin:actiontec admin:motorola admin:maxlinear admin:password
}

# Map a working "user:pass" back to a vendor profile (inverse of the factory
# defaults), so a discovered adapter can be adopted with the right vendor.
cred_vendor() {
	case "$1" in
		*:cambridge)            echo frontier ;;
		*:gocoax|*:gocoaxx|*:goCoax@2018) echo gocoax ;;
		*:admin)                echo verizon ;;
		*)                      echo generic ;;
	esac
}

# Probe one IP for the MaxLinear /ms API.  Emits a JSON object into the open
# array on success (MoCA adapter), nothing otherwise.  $1=ip $2=mac $3=via
probe_ms() {
	local ip="$1" mac="$2" via="$3" tmo cred hdr chip name sw r code first
	tmo="$(cfg_timeout)"
	# Fast reachability gate: one short request.  If nothing answers HTTP here
	# (code 000), bail immediately instead of spending a full timeout on every
	# credential -- that's what made whole-network discovery exceed the ubus
	# call timeout when several candidates were dead.
	first="$(printf '%s\n' $CREDS | head -1)"
	code="$(curl -s -m 2 -o /dev/null -w '%{http_code}' -H "$(basic_hdr "$first")" \
		-X POST "http://$ip/ms/1/0x303/GET" 2>/dev/null)"
	case "$code" in 000|"") return 1 ;; esac
	for cred in $CREDS; do
		hdr="$(basic_hdr "$cred")"
		r="$(curl -s -m "$tmo" -H "$hdr" -X POST "http://$ip/ms/1/0x303/GET" 2>/dev/null)"
		case "$r" in
			*'"data"'*)
				chip="$(echo "$r" | grep -oE '0x[0-9a-fA-F]+' | head -1)"
				sw="$(curl -s -m "$tmo" -H "$hdr" -X POST "http://$ip/ms/1/0x103/GET" 2>/dev/null | grep -oE '0x[0-9a-fA-F]+' | tr '\n' ' ')"
				name="$(curl -s -m "$tmo" -H "$hdr" -X POST "http://$ip/ms/1/0x212/GET" 2>/dev/null | grep -oE '0x[0-9a-fA-F]+' | head -1)"
				json_add_object ""
				json_add_string ip "$ip"
				json_add_string mac "$mac"
				json_add_string chip "$chip"
				json_add_string name "$name"
				json_add_string sw "$sw"
				json_add_string cred "${cred%%:*}"
				json_add_string vendor "$(cred_vendor "$cred")"
				json_add_string via "$via"
				json_close_object
				return 0 ;;
		esac
	done
	return 1
}

# Discover MoCA adapters on the network.
#   1. DHCP leases + neighbour table  (the plug-and-play happy path: an adapter
#      on DHCP shows up as a lease; we confirm it with an /ms probe).
#   2. Shared factory static IP(s)    (factory-fresh adapters all share one mgmt
#      IP -> ARP-collision: alias that subnet on the bridge, enumerate every MAC
#      answering the IP, then pin the IP to each MAC in turn and probe it).
method_discover() {
	. /lib/functions.sh
	CREDS="$(discover_creds | awk '!seen[$0]++')"

	local brdev alias static_ips seen_mac=" "
	config_load "$CFG"
	config_get brdev    globals bridge "br-lan"
	config_get alias    globals static_alias ""        # e.g. 192.168.144.2/24
	config_get static_ips globals static_ips "192.168.144.200"

	json_init
	json_add_array found

	# --- 1. DHCP leases + ARP/neighbour table -----------------------------
	# Collect candidates to a temp file and read from it (not a pipe) so the
	# while loop runs in THIS shell -- a "... | while" subshell would discard
	# every probe_ms json_add.
	local cand="/tmp/.moca_cand.$$"
	{
		[ -f /tmp/dhcp.leases ] && awk '{print $2, $3}' /tmp/dhcp.leases
		ip neigh show 2>/dev/null | awk '/lladdr/{print $5, $1}'
	} > "$cand"
	while read -r mac ip; do
		[ -n "$ip" ] && [ -n "$mac" ] || continue
		case "$seen_mac" in *" $mac "*) continue ;; esac
		seen_mac="$seen_mac$mac "
		probe_ms "$ip" "$mac" "dhcp"
	done < "$cand"
	rm -f "$cand"

	# --- 2. Shared factory static IP(s) -----------------------------------
	# These sit on an off-LAN subnet, so add a temporary alias on the bridge
	# (globals.static_alias) to get an L2 path, ping each static IP to learn its
	# MAC, then probe it.  (One device per IP; for several units colliding on the
	# SAME static IP, install 'arping' and enumerate -- noted in the docs.)
	if [ -n "$alias" ]; then
		ip addr add "$alias" dev "$brdev" 2>/dev/null
		local sip mac
		for sip in $static_ips; do
			ping -c 1 -W 1 "$sip" >/dev/null 2>&1
			mac="$(ip neigh show "$sip" dev "$brdev" 2>/dev/null | grep -oE '([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}' | head -1)"
			[ -n "$mac" ] || continue
			case "$seen_mac" in *" $mac "*) continue ;; esac
			seen_mac="$seen_mac$mac "
			probe_ms "$sip" "$mac" "static"
		done
		ip addr del "$alias" dev "$brdev" 2>/dev/null
	fi

	json_close_array

	# Vendor-agnostic census from the router's OWN MoCA chip (phy-mxl371x
	# moca_nodes sysfs): every node on the coax by GUID, no IP needed.  This
	# is the authoritative "how many adapters and which GUIDs" list to map
	# against what was reached over HTTP above.
	json_add_array census
	local nf
	# Shell '*' can't span soc@0/90000.mdio, so locate the attr with find.
	nf="$(find /sys/devices -name moca_nodes 2>/dev/null | head -1)"
	if [ -r "$nf" ]; then
		while read -r node role moca tx rx guid; do
			[ -n "$node" ] || continue
			json_add_object ""
			json_add_string node "${node#node}"
			json_add_string role "${role#role=}"
			json_add_string moca "${moca#moca=}"
			json_add_string guid "${guid#guid=}"
			json_close_object
		done < "$nf"
	fi
	json_close_array

	json_dump
}

# Adopt a discovered adapter: persist it to /etc/config/moca_other and, when
# asked, add a static DHCP reservation (keyed on its MAC) so it always gets the
# same IP -> true plug-and-play (after the adapter is flipped to DHCP).
method_adopt() {
	local input mac ip name vendor username password reserve
	read -r input
	json_load "$input"
	json_get_var mac mac
	json_get_var ip ip
	json_get_var name name
	json_get_var vendor vendor
	json_get_var username username
	json_get_var password password
	json_get_var reserve reserve

	[ -n "$ip" ] || { json_init; json_add_string error "missing ip"; json_dump; return; }
	[ -n "$name" ] || name="MoCA ${mac:-$ip}"
	[ -n "$vendor" ] || vendor="generic"
	[ -n "$username" ] || username="admin"

	# Stable section id from the MAC (fall back to the IP).
	local sid
	sid="moca_$(echo "${mac:-$ip}" | tr -cd '0-9a-fA-F' | tail -c 8)"

	uci -q set "$CFG.$sid=adapter"
	uci -q set "$CFG.$sid.name=$name"
	uci -q set "$CFG.$sid.host=$ip"
	uci -q set "$CFG.$sid.vendor=$vendor"
	uci -q set "$CFG.$sid.username=$username"
	[ -n "$password" ] && uci -q set "$CFG.$sid.password=$password"
	[ -n "$mac" ] && uci -q set "$CFG.$sid.mac=$mac"
	uci -q set "$CFG.$sid.enabled=1"
	uci -q commit "$CFG"

	local reserved=0
	if [ "$reserve" = 1 ] && [ -n "$mac" ]; then
		uci -q set "dhcp.$sid=host"
		uci -q set "dhcp.$sid.name=$sid"
		uci -q set "dhcp.$sid.mac=$mac"
		uci -q set "dhcp.$sid.ip=$ip"
		uci -q commit dhcp
		/etc/init.d/dnsmasq reload >/dev/null 2>&1
		reserved=1
	fi

	json_init
	json_add_string id "$sid"
	json_add_int reserved "$reserved"
	json_dump
}

# Locate the router's own MoCA PHY sysfs dir (phy-mxl371x moca_* attrs).
local_moca_dir() {
	local nf
	nf="$(find /sys/devices -name moca_nodes 2>/dev/null | head -1)"
	[ -n "$nf" ] && dirname "$nf"
}

# The MoCA GUIDs of the coax nodes other than this one, lower case, one per line.
census_guids() {
	local nf="$(local_moca_dir)/moca_nodes"

	[ -r "$nf" ] && awk '!/role=self/ { for (i = 1; i <= NF; i++) if ($i ~ /^guid=/) print tolower(substr($i, 6)) }' "$nf"
}

# reach_begin <ip> <mac>: make one adapter on any subnet reachable, even if others
# share its IP.  The neighbour is pinned so the address means this MAC only.
# REACH_SRC is what reach_end removes.
reach_begin() {
	local ip="$1" mac="$2" r d=2

	REACH_SRC=""
	r="$(ip route get "$ip" 2>/dev/null)"
	case "$r" in
	local*) return 1 ;;
	*" via "*|"")
		# a source on its subnet that nothing answered for
		while [ "${ip%.*}.$d" = "$ip" ] || grep -q "^${ip%.*}\.$d " "$SCAN_IPS" 2>/dev/null; do
			d=$((d + 1))
		done
		REACH_SRC="${ip%.*}.$d"
		ip addr add "$REACH_SRC/32" dev "$BR" 2>/dev/null
		ip route replace "$ip/32" dev "$BR" src "$REACH_SRC"
		;;
	esac
	ip neigh replace "$ip" lladdr "$mac" dev "$BR" nud permanent
}

reach_end() {
	local ip="$1"

	ip neigh del "$ip" dev "$BR" 2>/dev/null
	[ -n "$REACH_SRC" ] || return 0
	ip route del "$ip/32" dev "$BR" 2>/dev/null
	ip addr del "$REACH_SRC/32" dev "$BR" 2>/dev/null
}

# The background half of `scan`.  Starts from the census: an adapter is found when
# its GUID has an address, however many others answer on that address.
bg_scan() {
	local deep="$1" sweep bw nets tmp="/tmp/.moca_scan.$$" ip mac
	. /lib/functions.sh
	CREDS="$(discover_creds | awk '!seen[$0]++')"
	config_load "$CFG"
	config_get BR    globals bridge "br-lan"
	config_get sweep globals sweep "$SWEEP_DEFAULT"
	config_get bw    globals sweep_bandwidth "2M"
	config_get nets  globals deep_subnets "$DEEP_DEFAULT"

	# Sender 0.0.0.0: answered from any subnet, no address needed on ours.
	arp-scan -I "$BR" --arpspa=0.0.0.0 --retry=2 --bandwidth="$bw" --plain \
		--format='${ip} ${mac}' $sweep 2>/dev/null > "$tmp"
	# the bridge's own subnets (up to a /22), so a quiet adapter on the LAN shows up too
	ip -4 -o addr show dev "$BR" 2>/dev/null | awk '{split($4, a, "/"); if (a[2] >= 22) print $4}' |
		while read -r net; do
			arp-scan -I "$BR" --retry=2 --bandwidth="$bw" --plain \
				--format='${ip} ${mac}' "$net" 2>/dev/null
		done >> "$tmp"
	[ -f /tmp/dhcp.leases ] && awk '{print $3, $2}' /tmp/dhcp.leases >> "$tmp"
	ip neigh show dev "$BR" 2>/dev/null | awk '/lladdr/ {print $1, $3}' >> "$tmp"
	# deep: only the nodes still without an address, one frame per /24 to each
	if [ "$deep" = 1 ]; then
		census_guids | while read -r mac; do
			grep -qi " $mac$" "$tmp" || echo "$mac"
		done > "$tmp.m"
		[ -s "$tmp.m" ] && /usr/libexec/moca-sweep "$BR" $nets -- $(cat "$tmp.m") >> "$tmp" 2>/dev/null
	fi
	tr 'A-F' 'a-f' < "$tmp" | grep -E '^[0-9.]+ ([0-9a-f]{2}:){5}[0-9a-f]{2}$' | sort -u > "$tmp.u"
	census_guids > "$tmp.g"
	cp "$tmp.u" "$SCAN_IPS"

	json_init
	json_add_array found
	while read -r ip mac; do
		# only coax nodes: anything else on the LAN never sees a login attempt
		grep -qx "$mac" "$tmp.g" || continue
		reach_begin "$ip" "$mac" || continue
		probe_ms "$ip" "$mac" "scan" || {
			json_add_object ""
			json_add_string ip "$ip"
			json_add_string mac "$mac"
			json_add_string via "arp"
			json_close_object
		}
		reach_end "$ip"
	done < "$tmp.u"
	json_close_array
	json_add_array shared
	grep -Ff "$tmp.g" "$tmp.u" | awk '{print $1}' | sort | uniq -d > "$tmp.d"
	while read -r ip; do json_add_string "" "$ip"; done < "$tmp.d"
	json_close_array
	json_add_array missing
	while read -r mac; do
		grep -q " $mac$" "$tmp.u" || json_add_string "" "$mac"
	done < "$tmp.g"
	json_close_array
	json_add_string state done
	json_dump > "$SCAN_OUT.tmp"
	mv "$SCAN_OUT.tmp" "$SCAN_OUT"
	rm -f "$tmp" "$tmp".*
}

# The background half of `mps_start`: trigger, then wait for the report to end it.
bg_mps() {
	local d="$(local_moca_dir)" i=0 r t result=timeout walk

	while ! echo 1 > "$d/moca_mps_trigger" 2>/dev/null; do
		i=$((i + 1))
		[ "$i" -lt 5 ] || { mps_done "not started"; return; }
		sleep 2
	done

	walk="$(cat "$d/moca_cfg_mps_walk_time" 2>/dev/null)"
	i=0
	while [ "$i" -lt "$(( (${walk:-120} + 30) / 2 ))" ]; do
		sleep 2
		i=$((i + 1))
		r="$(cat "$d/moca_mps_report" 2>/dev/null)"
		case "$r" in *" valid=1 "*) ;; *) continue ;; esac
		t="${r#type=}"
		t="$(( ${t%% *} ))"
		# bit 3: the password moved, and a later bit ends the session
		[ $(( t & 0x8 )) = 0 ] || /usr/libexec/moca-privacy-save
		case "$r" in *" paired=1 "*) [ $(( t & 0x4 )) = 0 ] || result=paired ;; esac
		[ "$result" = paired ] && break
		[ $(( t & 0x4 )) = 0 ] || { result=failed; break; }
		[ $(( t & 0x10 )) = 0 ] || { result="in progress elsewhere"; break; }
		[ $(( t & 0x20 )) = 0 ] || { result="no other node joined"; break; }
		[ $(( t & 0x40 )) = 0 ] || { result="done, password unchanged"; break; }
		[ $(( t & 0x80 )) = 0 ] || { result="forwarded to the coordinator"; break; }
		[ $(( t & 0x100 )) = 0 ] || { result=failed; break; }
	done
	mps_done "$result"
}

mps_done() {
	json_init
	json_add_string state done
	json_add_string result "$1"
	json_dump > "$MPS_OUT.tmp"
	mv "$MPS_OUT.tmp" "$MPS_OUT"
}

method_mps_start() {
	[ -n "$(local_moca_dir)" ] || { json_init; json_add_string error "no moca dev"; json_dump; return; }
	json_init; json_add_string state running; json_dump > "$MPS_OUT"
	"$0" bg_mps >/dev/null 2>&1 </dev/null &
	cat "$MPS_OUT"
}

method_mps_status() {
	if [ -r "$MPS_OUT" ]; then cat "$MPS_OUT"; else echo '{"state":"idle"}'; fi
}

# `scan {deep}`: runs in the background, longer than a ubus call may take.
method_scan() {
	local input deep
	read -r input; json_load "$input"
	json_get_var deep deep
	command -v arp-scan >/dev/null || {
		json_init; json_add_string error "arp-scan not installed"; json_dump; return; }
	json_init; json_add_string state running; json_dump > "$SCAN_OUT"
	"$0" bg_scan "$deep" >/dev/null 2>&1 </dev/null &
	cat "$SCAN_OUT"
}

method_scan_status() {
	if [ -r "$SCAN_OUT" ]; then cat "$SCAN_OUT"; else echo '{"state":"idle"}'; fi
}

ip2int() {
	local IFS=. a b c d
	set -- $1
	echo "$(( ($1 << 24) + ($2 << 16) + ($3 << 8) + $4 ))"
}

# `readdress {ip,mac,newip,netmask,gateway,dhcp}`: one adapter, at the caller's
# explicit request; it reboots to take the address.  The caller rescans to verify.
method_readdress() {
	local input ip mac newip netmask gateway dhcp cred hdr code v jar tok
	read -r input; json_load "$input"
	json_get_var ip ip
	json_get_var mac mac
	json_get_var newip newip
	json_get_var netmask netmask
	json_get_var gateway gateway
	json_get_var dhcp dhcp
	for v in "$ip" "$newip" "$netmask" "$gateway"; do
		case "$v" in *[!0-9.]*) json_init; json_add_string error "bad address"; json_dump; return ;; esac
	done
	case "$mac" in *[!0-9a-fA-F:]*|"") json_init; json_add_string error "bad mac"; json_dump; return ;; esac
	[ -n "$ip" ] && { [ "$dhcp" = 1 ] || [ -n "$newip" ]; } || {
		json_init; json_add_string error "missing address"; json_dump; return; }

	. /lib/functions.sh
	CREDS="$(discover_creds | awk '!seen[$0]++')"
	config_load "$CFG"
	config_get BR globals bridge "br-lan"
	reach_begin "$ip" "$mac" || {
		json_init; json_add_string error "address is this router's"; json_dump; return; }
	for cred in $CREDS; do
		hdr="$(basic_hdr "$cred")"
		# a just-restarted adapter answers its first request 401, right login or not
		case "$(curl -s -m 3 -H "$hdr" -o /dev/null -X POST "http://$ip/ms/1/0x303/GET" 2>/dev/null
			curl -s -m 3 -H "$hdr" -X POST "http://$ip/ms/1/0x303/GET" 2>/dev/null)" in
			*'"data"'*) break ;;
		esac
		hdr=""
	done
	[ -n "$hdr" ] || {
		reach_end "$ip"; json_init; json_add_string error "no working login"; json_dump; return; }

	# the same csrf_token dance as the writes in method_request
	jar="/tmp/.moca_csrf.$$"
	curl -s -m 3 -c "$jar" -H "$hdr" -o /dev/null "http://$ip/" 2>/dev/null
	tok="$(awk '/csrf_token/{print $7}' "$jar" 2>/dev/null)"
	post() {
		curl -s -m 5 -o /dev/null -w '%{http_code}' -H "$hdr" -b "$jar" \
			-H "X-CSRF-TOKEN: $tok" -H 'Content-Type: application/x-www-form-urlencoded' \
			-H 'Accept: text/html, */*' --data "$2" -X POST "http://$ip/ms/1/$1" 2>/dev/null
	}
	put() { post "$1/PUT" "{\"data\":[$2]}"; }
	if [ "$dhcp" = 1 ]; then
		code="$(put 0x217 1)"
	else
		code="$(put 0x217 0)"
		[ "$code" = 200 ] && code="$(put 0x20b "$(ip2int "$newip")")"
		[ "$code" = 200 ] && [ -n "$netmask" ] && code="$(put 0x210 "$(ip2int "$netmask")")"
		[ "$code" = 200 ] && [ -n "$gateway" ] && code="$(put 0x211 "$(ip2int "$gateway")")"
	fi
	if [ "$code" = 200 ]; then
		post 0xb00 '{"data":[]}' >/dev/null
		json_init; json_add_boolean ok 1
	else
		json_init; json_add_string error "adapter refused the write ($code)"
	fi
	rm -f "$jar"
	reach_end "$ip"
	json_dump
}

# L2ME node census from the local chip: every coax node by GUID + role + rates,
# plus the active mask / NC / our own node id.  Vendor-agnostic, no IP.
method_census() {
	local d="$(local_moca_dir)"
	json_init
	json_add_array nodes
	if [ -n "$d" ] && [ -r "$d/moca_nodes" ]; then
		while read -r node role moca tx rx guid; do
			[ -n "$node" ] || continue
			local g="${guid#guid=}" host="" ip="" ll
			# Correlate the MoCA GUID (= the node's MAC) with a DHCP lease /
			# neighbour entry to name the device behind each node.
			if [ -n "$g" ] && [ "$g" != "unknown" ]; then
				ll="$(grep -i " $g " /tmp/dhcp.leases 2>/dev/null | head -1)"
				if [ -n "$ll" ]; then
					ip="$(echo "$ll" | awk '{print $3}')"
					host="$(echo "$ll" | awk '{print $4}')"
					[ "$host" = "*" ] && host=""
				fi
				[ -n "$ip" ] || ip="$(ip neigh show 2>/dev/null | grep -i "$g" | awk '{print $1}' | head -1)"
			fi
			json_add_object ""
			json_add_string node "${node#node}"
			json_add_string role "${role#role=}"
			json_add_string moca "${moca#moca=}"
			json_add_string tx "${tx#tx=}"
			json_add_string rx "${rx#rx=}"
			json_add_string guid "$g"
			json_add_string ip "$ip"
			json_add_string host "$host"
			json_close_object
		done < "$d/moca_nodes"
	fi
	json_close_array
	json_add_string active "$(cat "$d/moca_active_nodes" 2>/dev/null)"
	json_add_string nc "$(cat "$d/moca_nc_node_id" 2>/dev/null)"
	json_add_string self "$(cat "$d/moca_node_id" 2>/dev/null)"
	json_dump
}

# Reset remote node(s) over L2ME: input {nodemask, seconds?}.
method_node_reset() {
	local input nodemask seconds d
	read -r input; json_load "$input"
	json_get_var nodemask nodemask
	json_get_var seconds seconds
	d="$(local_moca_dir)"
	[ -n "$d" ] && [ -n "$nodemask" ] || {
		json_init; json_add_string error "no moca dev / nodemask"; json_dump; return; }
	if echo "$nodemask $seconds" > "$d/moca_node_reset" 2>/dev/null; then
		json_init; json_add_boolean ok 1; json_dump
	else
		json_init; json_add_string error "reset rejected by driver"; json_dump
	fi
}

# Generic L2ME/MoCA passthrough: input {cmd:"<cmdid> [words...]"} (all hex).
# Returns the driver's response line ("<bytes> <w0> <w1> ...").
method_node_cmd() {
	local input cmd d
	read -r input; json_load "$input"
	json_get_var cmd cmd
	d="$(local_moca_dir)"
	[ -n "$d" ] && [ -n "$cmd" ] || {
		json_init; json_add_string error "no moca dev / cmd"; json_dump; return; }
	# only hex words and spaces, never anything else
	case "$cmd" in *[!0-9a-fA-FxX\ ]*)
		json_init; json_add_string error "bad cmd"; json_dump; return ;;
	esac
	local resp
	if resp="$(moca_cmd_locked "$d" "$cmd")"; then
		json_init; json_add_string resp "$resp"; json_dump
	else
		json_init; json_add_string error "cmd rejected by driver"; json_dump
	fi
}

# The driver keeps one reply buffer for moca_cmd: a write followed by a read
# must not interleave with another caller's, so every use takes this lock.
MOCA_CMD_LOCK=/var/lock/moca_cmd

moca_cmd_locked() {
	local d="$1" cmd="$2" rc=0 out=""
	lock "$MOCA_CMD_LOCK"
	if echo "$cmd" > "$d/moca_cmd" 2>/dev/null; then
		out="$(cat "$d/moca_cmd" 2>/dev/null)"
	else
		rc=1
	fi
	lock -u "$MOCA_CMD_LOCK"
	[ "$rc" = 0 ] && echo "$out"
	return $rc
}

# Read-only SoC requests, checked word by word: the SoC trusts its arguments
# (an unknown profile type stops its firmware until the driver reloads it),
# and several stats commands clear their counters when word 0 is 1. Password
# reads (GetSecPassword, GetSecInfo, GetEnhancedSecInfo) are never allowed.
# Profile types seen working on firmware 1.18.16: 0x1/0x2/0xc/0xe/0x11/0x15
# and 0x21 (MoCA 2.5, channel 0-4 in bits 16+).
moca_read_ok() {
	local id="$1" a="$2" b="$3" c="$4" n="$5" t ch
	is_num() { case "$1" in ""|*[!0-9a-fA-FxX]*) return 1 ;; esac; printf '%d' "$1" >/dev/null 2>&1; }
	for t in "$a" "$b" "$c"; do [ -z "$t" ] || is_num "$t" || return 1; done
	node_ok() { is_num "$1" && [ "$(printf '%d' "$1")" -le 15 ]; }
	zero() { [ -z "$1" ] || [ "$(printf '%d' "$1")" = 0 ]; }
	case "$id" in
	0x1010001|0x1010009|0x1010015|0x1010024|0x101007f|0x1010027|0x1010032|0x1010092)
		[ "$n" -le 1 ] ;;
	0x1010016|0x1010022|0x101000b|0x1010033)
		[ "$n" = 2 ] && node_ok "$a" ;;
	0x1010010|0x1010011|0x1010013|0x1010014|0x1010026|0x1010052|0x1010054|0x1010056|0x1010072|0x101007e|0x1010093)
		[ "$n" -le 2 ] && zero "$a" ;;
	0x1010020|0x1010021)
		[ "$n" = 4 ] && node_ok "$a" || return 1
		t=$(( $(printf '%d' "$b") & 0xffff )); ch=$(( $(printf '%d' "$b") >> 16 ))
		case "$t" in 1|2|12|14|17|21) [ "$ch" = 0 ] ;; 33) [ "$ch" -le 4 ] ;; *) return 1 ;; esac || return 1
		case "$(printf '%d' "$c")" in 0|1) ;; *) return 1 ;; esac ;;
	0x101001d)
		[ "$n" = 3 ] && [ "$(printf '%d' "$a")" -ge 1 ] && [ "$(printf '%d' "$a")" -le 65535 ] &&
			[ "$(printf '%d' "$b")" = 2 ] ;;
	*) return 1 ;;
	esac
}

# Read access: run read-only SoC commands. Input {cmds: "<cmd> [words];..."},
# up to 64 requests, each "<cmdid> [hex words]". Returns {resp: [line, ...]}
# in the same order; a refused or failed request gives "" in its place.
method_stat() {
	local input cmds d one id n=0
	read -r input; json_load "$input"
	json_get_var cmds cmds
	d="$(local_moca_dir)"
	[ -n "$d" ] && [ -n "$cmds" ] || {
		json_init; json_add_string error "no moca dev / cmds"; json_dump; return; }
	case "$cmds" in *[!0-9a-fA-FxX\ \;]*)
		json_init; json_add_string error "bad cmds"; json_dump; return ;;
	esac
	json_init
	json_add_array resp
	local IFS=';'
	for one in $cmds; do
		n=$((n + 1)); [ $n -le 64 ] || break
		IFS=' '
		set -- $one
		id="$(printf '0x%x' "$1" 2>/dev/null)"
		if [ $# -le 4 ] && moca_read_ok "$id" "$2" "$3" "$4" $#; then
			json_add_string "" "$(moca_cmd_locked "$d" "$one")"
		else
			json_add_string "" ""
		fi
		IFS=';'
	done
	json_close_array
	json_dump
}

# Spectrum sweep: the chip measures what it receives in each 100 MHz block,
# with the given node sending a probe (node 0-15) or with no sender (node "",
# noise floor). Each block is an ACA request, a network transaction that
# takes about a second, so this is write access and a bounded range.
method_spectrum() {
	local input node start end d me blk last w2 out tries r st
	read -r input; json_load "$input"
	json_get_var node node
	json_get_var start start
	json_get_var end end
	d="$(local_moca_dir)"
	[ -n "$d" ] || { json_init; json_add_string error "no moca dev"; json_dump; return; }
	[ "$(cat "$d/moca_link_status" 2>/dev/null)" = up ] || {
		json_init; json_add_string error "coax link down"; json_dump; return; }
	case "$node$start$end" in *[!0-9]*)
		json_init; json_add_string error "bad arguments"; json_dump; return ;;
	esac
	[ -n "$node" ] && { [ "$node" -le 15 ] || {
		json_init; json_add_string error "bad node"; json_dump; return; }; }
	[ -n "$start" ] && [ -n "$end" ] && [ "$start" -ge 400 ] && [ "$end" -le 1750 ] &&
	[ "$start" -lt "$end" ] && [ $(( (end - start) / 100 )) -le 12 ] || {
		json_init; json_add_string error "range must be inside 400-1750 MHz, at most 1200 MHz wide"
		json_dump; return; }
	me="$(cat "$d/moca_node_id" 2>/dev/null)"
	case "$me" in ''|*[!0-9]*) json_init; json_add_string error "no node id"; json_dump; return ;; esac
	[ "$me" -le 15 ] || { json_init; json_add_string error "no node id"; json_dump; return; }
	[ "$node" = "$me" ] && { json_init; json_add_string error "that is this router"; json_dump; return; }
	json_init
	json_add_int node_id "$me"
	json_add_array blocks
	lock "$MOCA_CMD_LOCK"
	echo "0x101001c 1" > "$d/moca_cmd" 2>/dev/null
	blk=$((start / 25)); last=$(((end + 24) / 25))
	while [ $blk -lt $last ]; do
		tries=0; out=""
		while [ $tries -lt 3 ]; do
			tries=$((tries + 1))
			if [ -n "$node" ]; then
				r="0x101001a 5 1 $(printf %x $((blk + 2))) $(printf %x "$node") $(printf %x $((1 << me)))"
			else
				r="0x101001a 5 0 $(printf %x $((blk + 2))) 0 $(printf %x $((1 << me)))"
			fi
			echo "$r" > "$d/moca_cmd" 2>/dev/null && out="$(cat "$d/moca_cmd" 2>/dev/null)" || out=""
			set -- $out
			# words: $4 = result, $7 = ACA status; retry a busy network
			[ $# -ge 136 ] && [ "$4" = 00000000 ] && [ "$7" = 00000000 ] && break
			out=""; sleep 2
		done
		json_add_object ""
		json_add_int blk "$blk"
		json_add_string resp "$out"
		json_close_object
		blk=$((blk + 4))
	done
	echo "0x101001c 0" > "$d/moca_cmd" 2>/dev/null
	lock -u "$MOCA_CMD_LOCK"
	json_close_array
	json_dump
}

# Emit the adapter inventory (without passwords).
method_list() {
	json_init
	json_add_array adapters

	. /lib/functions.sh
	config_load "$CFG"

	add_adapter() {
		local s="$1" name host vendor username enabled mac
		config_get name     "$s" name "$s"
		config_get host     "$s" host ""
		config_get vendor   "$s" vendor "generic"
		config_get username "$s" username "admin"
		config_get enabled  "$s" enabled 1
		config_get mac      "$s" mac ""
		[ -n "$host" ] || return 0

		json_add_object ""
		json_add_string id "$s"
		json_add_string name "$name"
		json_add_string host "$host"
		json_add_string vendor "$vendor"
		json_add_string username "$username"
		json_add_string mac "$mac"
		json_add_boolean enabled "$enabled"
		json_close_object
	}

	config_foreach add_adapter adapter
	json_close_array
	json_dump
}

# Proxy one /ms call to a configured adapter.
# `request {id, path, body}` (write access): any /ms call, reads and writes.
method_request() {
	local input id path body
	read -r input
	json_load "$input"
	json_get_var id id
	json_get_var path path
	json_get_var body body
	ms_proxy "$id" "$path" "$body"
}

# `get {id, path, body}` (read access): only calls that change nothing on the
# adapter. A config read (<bank>/<param>/GET) or one of the status tables the
# status page reads (bank 0: 0x15 node mask, 0x16 node info, 0x103 PHY rates),
# with an empty body or one node number. Everything else is refused here,
# before the adapter is contacted; it needs `request`.
method_get() {
	local input id path body
	read -r input
	json_load "$input"
	json_get_var id id
	json_get_var path path
	json_get_var body body
	path="${path#/}"; path="${path#ms/}"
	echo "$path" | grep -qE '^([0-9]/0x[0-9a-fA-F]{1,8}/GET|0/0x(15|16|103))$' || {
		json_init; json_add_string error "not a read: $path"; json_dump; return
	}
	[ -z "$body" ] || echo "$body" | grep -qE '^\{"data":\[[0-9]*\]\}$' || {
		json_init; json_add_string error "bad body"; json_dump; return
	}
	ms_proxy "$id" "$path" "$body"
}

# Proxy one /ms call to the configured adapter <id>.
ms_proxy() {
	local id="$1" path="$2" body="$3"

	[ -n "$id" ] && [ -n "$path" ] || {
		json_init; json_add_string error "missing id/path"; json_dump; return
	}

	# Resolve target + creds strictly from UCI (never from the caller).
	. /lib/functions.sh
	config_load "$CFG"
	local host username password vendor enabled tmo
	config_get host     "$id" host ""
	config_get username "$id" username ""
	config_get password "$id" password ""
	config_get vendor   "$id" vendor "generic"
	config_get enabled  "$id" enabled 1
	[ -n "$host" ] || {
		json_init; json_add_string error "unknown adapter"; json_dump; return
	}

	# Credentials: per-adapter override if set, else the vendor factory default.
	local def; def="$(vendor_default_cred "$vendor")"
	[ -n "$username" ] || username="${def%%:*}"
	[ -n "$password" ] || password="${def#*:}"
	[ "$enabled" = 1 ] || {
		json_init; json_add_string error "adapter disabled"; json_dump; return
	}

	# Sanitize the path: only bank/param/verb tokens, no scheme/host/traversal.
	case "$path" in
		*..*|*/.*|*"//"*|http*|*" "*)
			json_init; json_add_string error "bad path"; json_dump; return ;;
	esac
	path="${path#/}"; path="${path#ms/}"

	[ -n "$body" ] || body='{"data":[]}'
	tmo="$(cfg_timeout)"

	# Writes (PUT / action endpoints) need the csrf_token cookie echoed back in
	# an X-CSRF-TOKEN header; reads (.../GET) don't.  Fetch it from the adapter
	# root first (newer firmware enforces it; older firmware just ignores it).
	local jar="" tok=""
	case "$path" in
		*/GET) ;;
		*)
			jar="/tmp/.moca_csrf.$$"
			curl -s -m "$tmo" -c "$jar" -H "$(basic_hdr "$username:$password")" \
				-o /dev/null "http://$host/" 2>/dev/null
			tok="$(awk '/csrf_token/{print $7}' "$jar" 2>/dev/null)"
		;;
	esac

	# Build the curl argv via positional params (keeps the header's space safe).
	set -- -s -m "$tmo" -w '___CODE___%{http_code}' \
		-H "$(basic_hdr "$username:$password")" \
		-H 'Content-Type: application/x-www-form-urlencoded' \
		-H 'Accept: text/html, */*'
	[ -n "$tok" ] && set -- "$@" -b "$jar" -H "X-CSRF-TOKEN: $tok"
	set -- "$@" --data "$body" -X POST "http://$host/ms/$path"

	# Split the body from the HTTP code with a literal token (ash has no $'\n').
	local out code raw
	out="$(curl "$@" 2>/dev/null)"
	[ -n "$jar" ] && rm -f "$jar"

	code="${out##*___CODE___}"
	raw="${out%%___CODE___*}"
	[ -n "$code" ] || code=0
	case "$code" in *[!0-9]*) code=0 ;; esac

	# Return the HTTP code and the adapter's raw {"data":[...]} body; the LuCI
	# view parses the JSON (all param semantics live client-side).
	json_init
	json_add_int code "$code"
	json_add_string raw "$raw"
	json_dump
}

