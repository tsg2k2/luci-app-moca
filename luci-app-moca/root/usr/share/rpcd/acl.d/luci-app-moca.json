{
	"luci-app-moca": {
		"description": "MoCA PHY status, coax nodes and adapter management",
		"read": {
			"file": {
				"/sys/devices/platform/*/mdio_bus/*/*:0f/moca_*": [ "read" ]
			},
			"ubus": {
				"moca": [ "list", "request", "discover", "census", "scan_status", "listen_status" ]
			},
			"uci": [ "moca", "moca_other" ]
		},
		"write": {
			"ubus": {
				"moca": [ "request", "discover", "adopt", "node_reset", "node_cmd", "scan", "listen", "readdress" ]
			},
			"uci": [ "moca", "moca_other", "dhcp" ]
		}
	}
}
