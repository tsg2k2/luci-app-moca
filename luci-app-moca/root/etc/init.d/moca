#!/bin/sh /etc/rc.common
# Push the persisted MoCA settings (/etc/config/moca) to the phy-mxl371x driver
# and apply them.  Individual values are staged via the moca_cfg_* sysfs
# attributes; moca_cfg_apply then re-initialises the SoC with the new config.

USE_PROCD=1
START=99

moca_sysfs_dir() {
	local d
	for d in /sys/class/mdio_bus/*/*:0f; do
		[ -w "$d/moca_cfg_apply" ] && { echo "$d"; return 0; }
	done
	return 1
}

# Plain numeric coax tuning options; each maps to moca_cfg_<option>.
MOCA_TUNING="phy_margin phy_margin_nper phy_margin_vlper tpc_mode tpc_rate_50
	tpc_rate_nper tpc_rate_vlper rlapm_band_mask sapm_band_mask lmo_mode
	mii_pause_pri policing_mode retx_priority tx_priority_per tlp_min tlp_max
	turbo_mode num_channels strip_vlan_tag"

# MOCA_CHANGED is set to 1 by moca_stage* when a staged value differs from the
# value already programmed in the driver, so we only re-initialise the SoC (a
# multi-second coax drop) when the config actually changed.

# moca_stage <sysfs-attr> <value>  (readable attr: stage + detect change)
moca_stage() {
	local cur
	[ -n "$2" ] || return 0
	cur=$(cat "$MOCA_DIR/$1" 2>/dev/null)
	if ! echo "$2" > "$MOCA_DIR/$1" 2>/dev/null; then
		logger -t moca "failed to stage $1='$2' (rejected by driver)"
		return 0
	fi
	[ "$cur" != "$2" ] && MOCA_CHANGED=1
}

# moca_stage_secret <sysfs-attr> <value>  (write-only attr: can't read back, so
# any non-empty value forces an apply)
moca_stage_secret() {
	[ -n "$2" ] || return 0
	if ! echo "$2" > "$MOCA_DIR/$1" 2>/dev/null; then
		logger -t moca "failed to stage $1 (rejected by driver)"
		return 0
	fi
	MOCA_CHANGED=1
}

# moca_stage_profiles <rlapm_profile|sapm_profile>  (a list of table lines the
# driver can't compare, so remember the last one applied since boot)
moca_stage_profile_line() {
	echo "$1" > "$MOCA_DIR/moca_cfg_$2" 2>/dev/null ||
		logger -t moca "failed to stage $2 '$1' (rejected by driver)"
	echo "$1" >> "$3"
}

moca_stage_profiles() {
	local last="/tmp/moca.$1" new="/tmp/moca.$1.new"

	: > "$new"
	config_list_foreach settings "$1" moca_stage_profile_line "$1" "$new"
	if cmp -s "$new" "$last" || { [ ! -s "$new" ] && [ ! -e "$last" ]; }; then
		rm -f "$new"
		return 0
	fi
	mv "$new" "$last"
	MOCA_CHANGED=1
}

moca_apply_config() {
	local enabled lof preferred_nc network_search security_mode network_name
	local password enhanced_password enhanced_privacy_mode
	local beacon_tx_power max_tx_power freq_band_mask opt val

	MOCA_DIR=$(moca_sysfs_dir) || {
		logger -t moca "MoCA sysfs not present; skipping config apply"
		return 0
	}

	config_load moca
	config_get_bool enabled       settings enabled 0
	[ "$enabled" = 1 ] || return 0

	config_get lof            settings lof
	config_get preferred_nc   settings preferred_nc
	config_get network_search settings network_search
	config_get security_mode  settings security_mode
	config_get network_name   settings network_name
	config_get password       settings password
	config_get enhanced_password settings enhanced_password
	config_get enhanced_privacy_mode settings enhanced_privacy_mode
	config_get beacon_tx_power settings beacon_tx_power
	config_get max_tx_power   settings max_tx_power
	config_get freq_band_mask settings freq_band_mask

	MOCA_CHANGED=0
	moca_stage moca_cfg_lof            "$lof"
	moca_stage moca_cfg_preferred_nc   "$preferred_nc"
	moca_stage moca_cfg_network_search "$network_search"
	moca_stage moca_cfg_security_mode  "$security_mode"
	moca_stage moca_cfg_network_name   "$network_name"
	moca_stage moca_cfg_enhanced_privacy_mode "$enhanced_privacy_mode"
	moca_stage moca_cfg_beacon_tx_power "$beacon_tx_power"
	moca_stage moca_cfg_max_tx_power   "$max_tx_power"
	moca_stage moca_cfg_freq_band_mask "$freq_band_mask"
	for opt in $MOCA_TUNING; do
		config_get val settings "$opt"
		moca_stage "moca_cfg_$opt" "$val"
	done
	moca_stage_profiles rlapm_profile
	moca_stage_profiles sapm_profile
	moca_stage_secret moca_cfg_password          "$password"
	moca_stage_secret moca_cfg_enhanced_password "$enhanced_password"

	# Only re-admit (multi-second coax drop) when something actually changed
	# from what the driver already applied at boot.
	if [ "$MOCA_CHANGED" != 1 ]; then
		logger -t moca "MoCA config matches running state; no re-init"
		return 0
	fi

	echo 1 > "$MOCA_DIR/moca_cfg_apply" 2>/dev/null
	logger -t moca "Applied MoCA configuration"
}

start_service() {
	moca_apply_config
}

reload_service() {
	moca_apply_config
}

service_triggers() {
	procd_add_reload_trigger "moca"
}
