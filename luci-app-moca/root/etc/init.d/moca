#!/bin/sh /etc/rc.common
# Push the persisted MoCA settings (/etc/config/moca) to the phy-mxl371x driver
# and apply them.  Individual values are staged via the moca_cfg_* sysfs
# attributes; moca_cfg_apply then re-initialises the SoC with the new config.

USE_PROCD=1
START=99

moca_sysfs_dir() {
	local d
	for d in /sys/class/mdio_bus/*/*:0f; do
		[ -w "$d/moca_cfg_apply" ] && { echo "$d"; return 0; }
	done
	return 1
}

# moca_stage <sysfs-attr> <value>  (no-op when value is empty)
moca_stage() {
	[ -n "$2" ] || return 0
	echo "$2" > "$MOCA_DIR/$1" 2>/dev/null
}

moca_apply_config() {
	local enabled lof preferred_nc network_search security_mode
	local password enhanced_password beacon_tx_power max_tx_power freq_band_mask

	MOCA_DIR=$(moca_sysfs_dir) || {
		logger -t moca "MoCA sysfs not present; skipping config apply"
		return 0
	}

	config_load moca
	config_get_bool enabled       settings enabled 0
	[ "$enabled" = 1 ] || return 0

	config_get lof            settings lof
	config_get preferred_nc   settings preferred_nc
	config_get network_search settings network_search
	config_get security_mode  settings security_mode
	config_get password       settings password
	config_get enhanced_password settings enhanced_password
	config_get beacon_tx_power settings beacon_tx_power
	config_get max_tx_power   settings max_tx_power
	config_get freq_band_mask settings freq_band_mask

	moca_stage moca_cfg_lof            "$lof"
	moca_stage moca_cfg_preferred_nc   "$preferred_nc"
	moca_stage moca_cfg_network_search "$network_search"
	moca_stage moca_cfg_security_mode  "$security_mode"
	moca_stage moca_cfg_password       "$password"
	moca_stage moca_cfg_enhanced_password "$enhanced_password"
	moca_stage moca_cfg_beacon_tx_power "$beacon_tx_power"
	moca_stage moca_cfg_max_tx_power   "$max_tx_power"
	moca_stage moca_cfg_freq_band_mask "$freq_band_mask"

	# Commit: re-initialise the SoC with the staged config (brief coax drop).
	echo 1 > "$MOCA_DIR/moca_cfg_apply" 2>/dev/null
	logger -t moca "Applied MoCA configuration"
}

start_service() {
	moca_apply_config
}

reload_service() {
	moca_apply_config
}

service_triggers() {
	procd_add_reload_trigger "moca"
}
